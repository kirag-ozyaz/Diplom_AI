{"id": "v2_90563c49a8b9edbedebab631254f2dff38ef671b", "content": "Групповая сеть. Пункт 6.2.15.\n\n6.2.15. Светильники, устанавливаемые в подвесные потолки из горючих материалов, должны иметь между местами их примыкания к конструкции потолка прокладки из негорючих теплостойких материалов в соответствии с требованиями НПБ 249-97.", "metadata": {"Document": "data/raw/Нормативная база/ПУЭ/DOCX/6.2.docx", "source_file": "data/raw/Нормативная база/ПУЭ/DOCX/6.2.docx", "Clause": "6.2.15", "Scope": "section_0000_run_0000", "ClauseKey": "[\"data/raw/Нормативная база/ПУЭ/DOCX/6.2.docx\", \"section_0000_run_0000\", \"6.2.15\"]", "Chapter": "6.2", "Section": "", "Paragraph": "Групповая сеть", "section_heading": "Групповая сеть", "block_title": "", "fragment_kind": "clause", "numbering_scheme": "hierarchical", "scope_resolution": "matched_scope_candidate", "owner_review_status": "manual_import_not_reviewed", "table_ownership": "requires_review", "reference_resolution": "not_performed", "references": [], "table_ids": [], "chunking_version": "v0-import-candidate-1", "document_version_sha256": null, "source_char_start": null, "source_char_end": null, "source_span_sha256": null, "extraction_warnings": ["manual_import_not_raw_extraction", "manual_formulas_tables_and_boundaries_require_review"], "legacy_metadata": {"Document": "", "Section": "", "Chapter": "", "Paragraph": "Групповая сеть", "Clause": "6.2.15", "contains_tables": false, "contains_images": false, "source_file": "6.2.md"}, "origin_provenance": {"kind": "legacy_jsonl", "source_id": "pue_6.2.15_6f960448", "source_jsonl": "6.2.chunked.jsonl", "source_line": 16, "source_jsonl_sha256": "196ca9c949de112383f6b292daaeb56de7094ea901104522e768f3d978edfcbd", "source_row_sha256": "69de558dc2037023c6a3b27d11a2e04c560417ded96164611a7bf0cc03d98726", "source_content_sha256": "469ab766bfab77b9ce3a481f87797c0d12b5b68ade54288acd0e56ed47f27fa1", "source_created_at": "2026-03-06T00:42:09.254169", "note": "source_file is a logical document as